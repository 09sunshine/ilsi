# ==============================================================================
# ILSI COHORT LEARNING PLATFORM - BACKEND ENVIRONMENT EXAMPLE
# ==============================================================================

# Server Runtime Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL Connection Pooling)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 2. SUPABASE (Storage Buckets: course-videos, course-resources, avatars)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 3. BETTER AUTHENTICATION
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=your-random-32-character-secret-key-for-session-signing
BETTER_AUTH_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD (Google OAuth & Google Calendar / Meet Live Sessions)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# ------------------------------------------------------------------------------
# 5. PAYMENT PROVIDERS & GATEWAYS
# ------------------------------------------------------------------------------
# Active provider feature flags (PayPal & Pay'm active; Stripe hidden by default)
PAYPAL_ENABLED=true
PAYM_ENABLED=true
STRIPE_ENABLED=false

# 5a. PayPal (Orders API v2 Checkout & Webhooks)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox # "sandbox" for development, "live" for production
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# 5b. Pay'm (Haitian Mobile Money & Multi-Method Payment API)
# Official Docs: https://plopplop.solutionip.app/paiement-doc
PAYM_CLIENT_ID=your-paym-client-id
PAYM_CLIENT_SECRET=your-paym-client-secret
PAYM_BASE_URL=https://plopplop.solutionip.app/
# Auditable exchange rate (HTG per USD) for Pay'm transactions with minimum 20 HTG
PAYM_USD_TO_HTG_RATE=132.0

# 5c. Stripe Payments (Preserved & Hidden when STRIPE_ENABLED=false)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Resend / Notification Delivery)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=admissions@ilsi-leadership.org
